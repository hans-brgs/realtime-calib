# Webapp build/runtime config (Vite, VITE_* — exposed to the browser, no secrets).
# Copy to `.env` for local `yarn dev`. Values are propagated from the root HOST_IP.
# Everything goes through Caddy in plain http/ws on HOST_IP (ADR-0063).

VITE_HOST_IP=192.168.1.42
VITE_API_URL=http://192.168.1.42/api
VITE_LIVEKIT_URL=ws://192.168.1.42/livekit
VITE_TOKEN_URL=http://192.168.1.42/token
